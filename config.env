###############################################################################
# Required
#
# These values MUST be changed before deploying the project.
###############################################################################

# AWS Region
AWS_REGION="us-east-1"

# GitHub Configuration
GITHUB_OWNER="sumee1907"                                       # Your GitHub username
GITHUB_REPOSITORY="aws-cloudformation-app-pipeline"          # Your GitHub repository name
GITHUB_BRANCH="main"                                         # The branch to build
GITHUB_CONNECTION_ARN="arn:aws:codeconnections:us-east-1:565393026966:connection/3b603953-8d8e-467c-ab90-5e0ba8f229a6"  # AWS CodeConnections ARN

# Project
PROJECT_NAME="aes"

###############################################################################
# Optional
#
# Default values that normally do not need to be changed.
###############################################################################

# Environment
ENVIRONMENT="dev"

# ECR
ECR_EMPTY_ON_DELETE=true # if true, the ECR repositories will be emptied when the stack is deleted

# S3
DELETE_S3_ON_DESTROY=true # if true, the S3 bucket will be deleted when the stack is deleted

# Network
VPC_CIDR="10.0.0.0/16"

PUBLIC_SUBNET_A_CIDR="10.0.0.0/24"
PUBLIC_SUBNET_B_CIDR="10.0.1.0/24"

PRIVATE_SUBNET_A_CIDR="10.0.2.0/24"
PRIVATE_SUBNET_B_CIDR="10.0.3.0/24"

# ECS
FRONTEND_DESIRED_COUNT=2
BACKEND_DESIRED_COUNT=2

FRONTEND_CPU=256
FRONTEND_MEMORY=512

BACKEND_CPU=256
BACKEND_MEMORY=512

# Deployment
FRONTEND_BAKE_TIME_MINUTES=5

# Logging
LOG_RETENTION_DAYS=7

# Application
FRONTEND_PORT=80
BACKEND_PORT=3000
